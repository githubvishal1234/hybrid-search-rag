# Copy to .env and fill in. Every field in src/hybrid_rag/config.py can be overridden here (case-insensitive).

# Qdrant: empty = embedded mode (no server, stored in data/processed/qdrant).
# Docker: http://localhost:6333. Qdrant Cloud: cluster URL + API key.
QDRANT_URL=
QDRANT_API_KEY=

# LLM provider: ollama (local, no key) | openai | anthropic | gemini. Set LLM_MODEL to match.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Reranker: local (bge-reranker-base on CPU) | cohere
RERANKER_PROVIDER=local
COHERE_API_KEY=

# Retrieval knobs (defaults shown)
# CHUNK_SIZE=450
# CHUNK_OVERLAP=64
# DENSE_TOP_K=30
# BM25_TOP_K=30
# RRF_K=60
# CONTEXT_TOP_N=5
# RERANK_CANDIDATES=30
# RERANKER_MODEL=BAAI/bge-reranker-base   # or jinaai/jina-reranker-v1-turbo-en (~4x faster)
